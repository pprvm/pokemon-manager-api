{
  "name": "pokemanager-api",
  "version": "0.2.0",
  "description": "API REST para gerenciamento de treinadores e pokémons - Projeto de Banco de Dados (UFF)",
  "main": "dist/main/server.js",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "pokemon",
    "api",
    "clean-architecture"
  ],
  "author": "Pedro",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
