generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PokemonType {
  normal
  fire
  water
  grass
  electric
  ice
  fighting
  poison
  ground
  flying
  psychic
  bug
  rock
  ghost
  dragon
  dark
  steel
  fairy

  @@map("pokemon_type")
}

/// Catálogo local de espécies (CRUD da entrega 1)
model Pokemon {
  id             Int           @id @default(autoincrement())
  pokedexNumber  Int           @unique @map("pokedex_number")
  name           String        @unique @db.VarChar(50)
  types          PokemonType[]
  height         Int
  weight         Int
  hp             Int           @db.SmallInt
  attack         Int           @db.SmallInt
  defense        Int           @db.SmallInt
  specialAttack  Int           @map("special_attack") @db.SmallInt
  specialDefense Int           @map("special_defense") @db.SmallInt
  speed          Int           @db.SmallInt
  spriteUrl      String?       @map("sprite_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("pokemons")
}

model Trainer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(80)
  email     String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  captures  Capture[]

  @@map("trainers")
}

/// Pokémon capturado por um treinador. Os dados vêm da PokéAPI no momento da captura
/// e ficam salvos aqui (snapshot), então o time não depende da API externa para ser listado.
model Capture {
  id             String        @id @default(uuid()) @db.Uuid
  trainerId      String        @map("trainer_id") @db.Uuid
  pokedexNumber  Int           @map("pokedex_number")
  pokemonName    String        @map("pokemon_name") @db.VarChar(50)
  nickname       String?       @db.VarChar(30)
  types          PokemonType[]
  height         Int
  weight         Int
  hp             Int           @db.SmallInt
  attack         Int           @db.SmallInt
  defense        Int           @db.SmallInt
  specialAttack  Int           @map("special_attack") @db.SmallInt
  specialDefense Int           @map("special_defense") @db.SmallInt
  speed          Int           @db.SmallInt
  spriteUrl      String?       @map("sprite_url")
  capturedAt     DateTime      @default(now()) @map("captured_at")

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("captures")
}
